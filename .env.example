# Shared tribute and RSVP poster walls — copy to .env for local runs (never commit real values)

# PostgreSQL connection string (Neon, Vercel Postgres, Supabase Postgres, RDS...).
# Local: postgresql://user:password@localhost:5432/tributes
DATABASE_URL=
# Vercel Postgres/Neon integrations may provide POSTGRES_URL automatically.
# POSTGRES_URL=

# Guest portrait storage (server-side only; never prefix these with VITE_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, Cloudinary's combined connection value can replace the three above:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Administrator sign-in (single admin account)
ADMIN_EMAIL=

# Plain password (simplest). Prefer ADMIN_PASSWORD_HASH below for production.
ADMIN_PASSWORD=

# Optional but recommended: scrypt hash instead of plain password.
# Format: scrypt$<saltHex>$<hashHex> — generate with (Node):
#   node -e "const c=require('crypto');const salt=c.randomBytes(16);console.log('scrypt$'+salt.toString('hex')+'$'+c.scryptSync(process.argv[1],salt,64).toString('hex'))" 'YOUR_PASSWORD'
ADMIN_PASSWORD_HASH=

# Long random string used to sign admin session cookies, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
